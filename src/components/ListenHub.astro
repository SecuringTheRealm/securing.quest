---
import { PODCAST_PLATFORMS, type PodcastPlatform } from '../utils/podcast';
import SubscribeChip from './SubscribeChip.astro';

export interface Props {
	band?: boolean;
}

const { band = false } = Astro.props;

const primary = PODCAST_PLATFORMS.filter((p: PodcastPlatform) => p.filled);
const secondary = PODCAST_PLATFORMS.filter((p: PodcastPlatform) => !p.filled);
---

<section
	id="listen"
	class:list={['listen-hub', { 'section--band': band }]}
	aria-labelledby="listen-heading"
>
	<div class:list={[{ 'band-inner': band }]}>
		<h2 id="listen-heading" class="section-heading">Listen to the Podcast</h2>
		<p class="listen-hub__featured">
			New to the party? Start with
			<a href="https://www.youtube.com/watch?v=Z5aPUgfwKQc">Red Teaming AI Agents with Pramin Pradeep</a>.
			We talk through how to test AI agents before deployment and monitor them in production.
		</p>
		<div class="listen-hub__chips">
			{
				primary.map((platform: PodcastPlatform) => (
					<SubscribeChip
						href={platform.href}
						label={platform.label}
						platform={platform.label}
						filled={true}
					/>
				))
			}
		</div>
		<div class="listen-hub__chips listen-hub__chips--secondary">
			{
				secondary.map((platform: PodcastPlatform) => (
					<SubscribeChip
						href={platform.href}
						label={platform.label}
						platform={platform.label}
						filled={false}
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	.listen-hub {
		text-align: center;
		scroll-margin-block-start: var(--space-4);
	}

	@media (max-width: 768px) {
		.listen-hub {
			scroll-margin-block-start: 0;
		}
	}

	.listen-hub__featured {
		max-width: var(--max-width-narrow);
		margin: 0 auto var(--space-heading);
	}

	.listen-hub__featured a {
		text-decoration: underline;
	}

	/* 16px on both axes, so chips that wrap within a row sit the same distance
	   apart as the two rows do. Matches the button-row gap used site-wide. */
	.listen-hub__chips {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
		justify-content: center;
	}

	.listen-hub__chips--secondary {
		margin-top: var(--space-4);
	}
</style>
