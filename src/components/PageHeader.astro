---
export interface Props {
	title: string;
	eyebrow?: string;
	realm?: 'tower' | 'library' | 'forge' | 'moon';
}

const { title, eyebrow, realm } = Astro.props;
---

<header class="page-header" data-realm={realm}>
	<div class="page-header__copy">
		{eyebrow && !title.startsWith(eyebrow) && <p class="page-header__eyebrow">{eyebrow}</p>}
		<div class="page-header__heading">
			{
				Astro.slots.has('icon') && (
					<div class="page-header__icon">
						<slot name="icon" />
					</div>
				)
			}
			<h1 class="page-header__title">{title}</h1>
		</div>
		{
			Astro.slots.has('default') && (
				<div class="page-header__intro">
					<slot />
				</div>
			)
		}
	</div>
	{
		Astro.slots.has('actions') && (
			<div class="page-header__actions">
				<slot name="actions" />
			</div>
		)
	}
</header>

<style>
	.page-header {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-3) var(--space-6);
		margin-bottom: var(--space-8);
	}

	.page-header__copy {
		min-width: 0;
	}

	.page-header__heading {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.page-header__icon {
		flex: 0 0 var(--space-8);
	}

	.page-header__icon :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (max-width: 768px) {
		.page-header {
			display: grid;
			align-items: start;
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.page-header__eyebrow {
		margin: 0;
		padding-bottom: var(--space-1);
		border-bottom: 2px solid var(--realm-accent);
		font-family: var(--font-display);
		font-size: var(--font-size-xs);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		color: var(--colour-gold);
	}

	.page-header__title {
		margin: 0;
	}

	.page-header__intro {
		max-width: var(--max-width-narrow);
		margin-top: var(--space-2);
		font-size: var(--font-size-lg);
	}

	.page-header__actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
</style>
