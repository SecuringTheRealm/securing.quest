---
/**
 * Click-to-load YouTube facade. Renders a poster and a play button; the real
 * iframe is only created on click, so no third-party player loads on page view.
 * Without JS the anchor is a plain link to YouTube.
 */
export interface Props {
	embedUrl: string;
	videoUrl: string;
	title: string;
	thumbnailUrl?: string | null;
	/** Set on the first facade in the viewport so the poster is not lazy-loaded. */
	eager?: boolean;
}

const { embedUrl, videoUrl, title, thumbnailUrl, eager = false } = Astro.props;
---

<div class="video-player">
	<div class="video-frame">
		<a
			class="video-facade"
			href={videoUrl}
			data-embed={embedUrl}
			data-title={title}
			target="_blank"
			rel="noopener noreferrer"
			data-action="video"
			aria-label={`Play video: ${title} (opens YouTube)`}
		>
			{/* A poster slot beats the raw YouTube still: multi-cam recordings letterbox
			    and crop faces. Callers pass a branded poster; the still is the fallback. */}
			<slot name="poster">
				{
					thumbnailUrl && (
						<img
							src={thumbnailUrl}
							alt=""
							loading={eager ? 'eager' : 'lazy'}
							width="480"
							height="270"
						/>
					)
				}
			</slot>
			<span class="video-facade__play" aria-hidden="true"></span>
		</a>
	</div>
	<a class="video-player__external" href={videoUrl} target="_blank" rel="noopener noreferrer" data-action="video" hidden>
		Watch on YouTube <span class="sr-only">(opens in a new tab)</span>
	</a>
</div>

<style>
	.video-player {
		min-width: 0;
	}

	.video-player.is-playing .video-frame {
		/* YouTube requires a player viewport of at least 200 × 200 px. */
		inline-size: 100%;
		min-block-size: 200px;
	}

	.video-player__external:not([hidden]) {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--space-12);
		padding-inline: var(--space-4);
	}

	.video-frame {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--colour-black);
		overflow: hidden;
	}

	.video-facade {
		position: absolute;
		inset: 0;
		display: block;
	}

	/* Inset ring so it isn't clipped by the frame's overflow: hidden */
	.video-facade:focus-visible,
	.video-frame :global(iframe:focus-visible) {
		outline: 3px solid var(--colour-gold);
		outline-offset: calc(-1 * var(--space-1));
	}

	.video-facade img,
	.video-facade :global(> *:not(.video-facade__play)) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.video-facade__play {
		position: absolute;
		right: var(--space-4);
		bottom: var(--space-4);
		width: var(--space-16);
		height: var(--space-16);
		background: var(--colour-gold);
		border: 2px solid var(--colour-ink);
		border-radius: var(--radius-pixel);
	}

	/* Pixel play triangle, stacked rectangles - no smooth curves */
	.video-facade__play::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 55%;
		transform: translate(-50%, -50%);
		border-style: solid;
		border-width: var(--space-3) 0 var(--space-3) var(--space-4);
		border-color: transparent transparent transparent var(--colour-ink);
	}

	.video-frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>

<script>
	// Astro includes this script once even when the page renders many facades.
	document.querySelectorAll<HTMLAnchorElement>('.video-facade').forEach((facade: HTMLAnchorElement) => {
		facade.addEventListener('click', (event: MouseEvent) => {
			if (
				event.defaultPrevented || event.button !== 0 || event.metaKey ||
				event.ctrlKey || event.shiftKey || event.altKey
			) return;

			const embed = facade.dataset.embed;
			const player = facade.closest('.video-player');
			const externalLink = player?.querySelector<HTMLAnchorElement>('.video-player__external');
			if (!embed || !player || !externalLink) return;

			event.preventDefault();
			const iframe = document.createElement('iframe');
			const video = new URL(embed);
			video.searchParams.set('autoplay', '1');
			iframe.src = video.href;
			iframe.title = facade.dataset.title || 'Video';
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
			iframe.allowFullscreen = true;
			iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation allow-popups');
			iframe.setAttribute('tabindex', '0');
			facade.replaceWith(iframe);
			player.classList.add('is-playing');
			externalLink.hidden = false;
			iframe.focus();
		});
	});
</script>
