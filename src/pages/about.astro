---
import AuthorCard from '../components/AuthorCard.astro';
import ListenHub from '../components/ListenHub.astro';
import RealmSigil from '../components/RealmSigil.astro';
import Base from '../layouts/Base.astro';
import { AUTHORS } from '../utils/authors';
---

<Base
  title="About Our Quest"
  description="Meet Chris Lloyd-Jones and Josh McDonald, explore the topics behind Securing the Realm and find your first episode."
>
  <div class="container page-shell about-page">
    <section class="about-mission">
      <div class="about-heading">
        <RealmSigil realm="keep" size={32} />
        <h1>About Our Quest</h1>
      </div>
      <p class="mission-lede">
        We’re Chris Lloyd-Jones and Josh McDonald. On Securing the Realm, we compare notes on AI
        with the people building platforms, setting policy and investigating what can go wrong.
        Our fondness for Dungeons &amp; Dragons turns up in the <a href="https://www.youtube.com/watch?v=CzzeOotjlwU">Christmas special</a>,
        where we talk about building an AI dungeon master.
      </p>
      <div class="mission-actions">
        <a href="#listen" class="btn-primary">Listen to the Podcast</a>
        <a href="/talks/" class="btn-outline">Watch Talks</a>
      </div>
    </section>

    <section class="about-party">
      <h2 class="section-heading">Meet the Party</h2>
      <div class="host-grid">
        <AuthorCard author={AUTHORS.chris} />
        <AuthorCard author={AUTHORS.josh} />
      </div>
    </section>

    <div class="about-scope">
      <section>
        <h2>Who This Is For</h2>
        <p>
          You might be choosing where a model should run, writing your organisation’s first AI policy
          or investigating something an agent did. If any of that sounds like your week, pull up a chair.
        </p>
      </section>

      <section>
        <h2>What We Cover</h2>
        <ul>
          <li><strong>Governance.</strong> Bruno Lecoq explains what small businesses can do when staff are already using AI tools.</li>
          <li><strong>Platforms.</strong> In <a href="https://www.youtube.com/watch?v=FKG8-H6RVDU">Foundry Local Launch</a>, we run models on our own hardware to work with sensitive material.</li>
          <li><strong>Cybersecurity.</strong> We look at how deepfakes are used in fraud and how to test what an AI agent will do with the permissions it has.</li>
        </ul>
      </section>
    </div>

    <ListenHub />
  </div>
</Base>

<style>
  .about-page {
    display: grid;
    gap: var(--space-section);
  }

  .about-mission,
  .about-party,
  .about-scope {
    width: 100%;
    margin-inline: auto;
  }

  .about-mission {
    max-width: var(--measure);
  }

  .about-party,
  .about-scope {
    max-width: var(--max-width-content);
  }

  .about-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .about-heading :global(svg) {
    flex: none;
  }

  .about-heading h1 {
    margin: 0;
  }


  .about-scope h2 {
    margin-block-end: var(--space-3);
  }

  .mission-lede,
  .about-scope {
    line-height: var(--line-height-relaxed);
  }

  .mission-lede {
    font-size: var(--font-size-lg);
  }

  .mission-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .about-scope {
    display: grid;
    gap: var(--space-8);
  }

  .about-scope p,
  .about-scope ul {
    margin-block-end: 0;
  }

  .host-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 769px) {
    .host-grid,
    .about-scope {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
