---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AuthorByline from '../../components/AuthorByline.astro';
import BlogTable from '../../components/BlogTable.astro';
import Giscus from '../../components/Giscus.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import Webmentions from '../../components/Webmentions.astro';
import Base from '../../layouts/Base.astro';
import { resolveRelated } from '../../utils/relatedContent';

export const getStaticPaths = (async () => {
	const blogEntries = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
		return data.draft !== true;
	});

	return blogEntries.map((entry: CollectionEntry<'blog'>) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

interface Props {
	entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const related = resolveRelated(entry.data.relatedContent ?? []);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  article={true}
  publishDate={entry.data.pubDate}
  tags={entry.data.tags}
>
  <article class="h-entry container page-shell post" data-realm="library">
    <a class="u-url" href={canonicalURL} style="display: none;">{entry.data.title}</a>
    <header class="post-heading">
      <h1 class="p-name">{entry.data.title}</h1>
      <div class="post-byline">
        <time class="dt-published" datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
        <AuthorByline authorId={entry.data.author} />
      </div>
    </header>

    <div class="e-content prose post-body">
      <Content components={{ table: BlogTable }} />
    </div>

    {entry.data.tags.length > 0 && (
      <div class="post-tags">
        {entry.data.tags.map((tag: string) => (
          <a href={`/tags/${tag}/`} class="p-category tag-chip">
            {tag}
          </a>
        ))}
      </div>
    )}

    <RelatedContent items={related} realm="library" />

    <Webmentions />

    <Giscus />

    <footer style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 2px solid var(--colour-gold);">
      <a href="/blog/" class="btn-primary">
        ← Back to Library
      </a>
    </footer>
  </article>
</Base>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(100%, var(--reading-measure)) minmax(0, 1fr);
    max-width: var(--max-width-content);
    padding-inline: var(--space-4);
    font-size: var(--font-size-lg);
  }

  .post > :global(*),
  .post-body > :global(*) {
    grid-column: 2;
    min-inline-size: 0;
  }

  .post-heading {
    margin-block-end: var(--space-6);
  }

  .post-heading h1 {
    margin-block-end: var(--space-3);
  }

  .post-byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .post-byline :global(.author-byline) {
    margin: 0;
  }

  .dt-published {
    color: var(--colour-stone-light);
    font-size: var(--font-size-sm);
  }

  .post-body {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    line-height: var(--line-height-relaxed);
  }

  .post-body > :global(:is(.table-scroll, figure, img, pre, p:has(> img:only-child))) {
    grid-column: 1 / -1;
  }

  .post-body :global(:is(h2, h3):not(:first-child)) {
    margin-block-start: var(--space-6);
    margin-block-end: var(--space-3);
  }

  .post-body :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-6);
  }
</style>
