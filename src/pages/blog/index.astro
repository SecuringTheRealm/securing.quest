---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import LibraryIcon from '../../components/LibraryIcon.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { formatIndexDate } from '../../utils/dates';

const allBlogPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
	return data.draft !== true;
});

const sortedPosts = allBlogPosts.sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// The post links to every topic in its original order.
const TAG_LIMIT = 2;
---

<Base title="Library - Blog Posts">
  <div class="container page-shell library-page">
    <PageHeader title="The Library · Blog" realm="library">
      <LibraryIcon slot="icon" />
      Notes on architecture and security, including what broke along the way.
      <a
        slot="actions"
        href="/blog/rss.xml"
        class="btn-primary btn-sm"
      >
        RSS Feed
      </a>
    </PageHeader>

    <div class="post-list" data-realm="library">
      {sortedPosts.length === 0 && (
        <p class="empty-list">
          The shelves are bare. New scrolls will appear here.
        </p>
      )}
      {sortedPosts.map((post: CollectionEntry<'blog'>) => (
        <article class="post-row">
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatIndexDate(post.data.pubDate)}
          </time>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.slice(0, TAG_LIMIT).map((tag: string) => (
                <a href={`/tags/${tag}/`} class="tag-chip">
                  {tag}
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .library-page {
    max-width: var(--max-width-content);
  }

  .post-list {
    display: grid;
    gap: var(--space-3);
  }

  .post-row {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border-inline-start: 2px solid var(--colour-stone-dark);
    background: var(--colour-teal-dark);
  }

  .post-row h2,
  .post-row p {
    margin: 0;
  }

  .post-row h2 {
    font-size: var(--font-size-xl);
  }

  .post-row h2 a {
    color: var(--colour-parchment);
    text-decoration: underline;
    text-decoration-color: var(--colour-stone-dark);
    text-underline-offset: 0.16em;
  }

  .post-row h2 a:hover,
  .post-row h2 a:focus-visible {
    color: var(--colour-gold-light);
    text-decoration-color: currentColor;
  }

  .post-row time,
  .empty-list {
    color: var(--colour-stone-light);
  }

  .post-row time {
    font-size: var(--font-size-sm);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }

</style>
