---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ForgeIcon from '../../components/ForgeIcon.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubscribeChip from '../../components/SubscribeChip.astro';
import Base from '../../layouts/Base.astro';
import { formatIndexDate } from '../../utils/dates';

type Project = CollectionEntry<'projects'>;
interface ProjectGroup {
	title: string;
	projects: Project[];
}

const projects = (await getCollection('projects')).sort(
	(a: Project, b: Project) =>
		(b.data.firstPublic?.valueOf() ?? -Infinity) - (a.data.firstPublic?.valueOf() ?? -Infinity)
);
const groups = [
	{
		title: 'Active projects',
		projects: projects.filter((project: Project) => project.data.status === 'active'),
	},
	{
		title: 'Experimental and archived',
		projects: projects.filter((project: Project) => project.data.status !== 'active'),
	},
].filter((group: ProjectGroup) => group.projects.length > 0);
---

<Base title="Forge - Projects & Code">
  <div class="container page-shell">
    <PageHeader title="The Forge · Code" realm="forge">
      <ForgeIcon slot="icon" />
      Open-source projects, templates and demos built for the show.
      <SubscribeChip
        slot="actions"
        href="https://github.com/SecuringTheRealm"
        label="Follow on GitHub"
        platform="GitHub"
      />
    </PageHeader>

    {groups.length === 0 && <p>The forge is being stoked. Projects will appear here soon!</p>}

    {groups.map((group: ProjectGroup) => (
      <section class="project-catalogue">
        <h2>{group.title}</h2>
        <div class="project-grid">
          {group.projects.map((project: Project) => (
            <article id={project.id} class="content-card project-card">
              <h3>{project.data.name}</h3>
              {project.data.status !== 'active' && (
                <p class="project-status">{project.data.status === 'archived' ? 'Archived' : 'Experimental'}</p>
              )}
              <p class="project-purpose">{project.data.description}</p>
              <a class="project-link" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
                View on GitHub<span class="sr-only">: {project.data.name} (opens in a new tab)</span>
              </a>
              {(project.data.firstPublic || project.data.tech.length > 0) && (
                <details class="project-details">
                  <summary>Project details</summary>
                  {project.data.tech.length > 0 && <p>{project.data.tech.join(' · ')}</p>}
                  {project.data.firstPublic && (
                    <p>First public: <time datetime={project.data.firstPublic.toISOString()}>{formatIndexDate(project.data.firstPublic)}</time></p>
                  )}
                </details>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .project-catalogue + .project-catalogue {
      margin-block-start: var(--space-12);
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: var(--space-6);
      align-items: start;
    }

    .project-card {
      display: grid;
      gap: var(--space-3);
      min-width: 0;
      padding: var(--space-6);
      border-color: var(--colour-stone-dark);
      box-shadow: none;
    }

    .project-card h3 {
      margin: 0;
      font-size: var(--font-size-xl);
      font-variant-caps: normal;
      letter-spacing: normal;
      color: var(--colour-parchment);
      overflow-wrap: anywhere;
    }

    .project-card p {
      margin: 0;
    }

    .project-status {
      font-weight: var(--font-weight-bold);
    }

    .project-status,
    .project-details {
      color: var(--colour-stone-light);
      font-size: var(--font-size-sm);
    }

    .project-link,
    .project-details summary {
      width: fit-content;
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }

    .project-details summary {
      cursor: pointer;
    }

    .project-details summary:focus-visible {
      outline: 2px solid var(--colour-gold);
      outline-offset: var(--space-1);
    }

    .project-details p {
      margin-block-start: var(--space-2);
    }
  </style>

  <script is:inline>
    document.querySelectorAll('article').forEach(function (article) {
      var name = (article.querySelector('h3') || {}).textContent || 'Unknown';
      article.querySelectorAll('a[target="_blank"]').forEach(function (link) {
        link.addEventListener('click', function () {
          if (typeof plausible !== 'undefined') {
            plausible('Project Click', { props: { project: name.trim() } });
          }
        });
      });
    });
  </script>
</Base>
