---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import CastleSceneRetro from '../components/CastleSceneRetro.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import ListenHub from '../components/ListenHub.astro';
import RealmSigil from '../components/RealmSigil.astro';
import VideoFacade from '../components/VideoFacade.astro';
import Base from '../layouts/Base.astro';
import { formatIndexDate } from '../utils/dates';
import { selectQuestLog } from '../utils/quest-log';
import { getTalkCatalogue, getTalkKind, type TalkKind } from '../utils/talks';
import {
	fetchYouTubeShorts,
	fetchYouTubeTalks,
	getYouTubeEmbedUrl,
	getYouTubeThumbnailUrl,
	toSummary,
	type YouTubeShort,
	type YouTubeTalk,
} from '../utils/youtube';

// Unified content item for the Quest Log feed
interface FeedItem {
	title: string;
	url: string;
	date: Date;
	kind: TalkKind | 'Short' | 'Article' | 'Project';
	description: string;
	realm: 'tower' | 'library' | 'forge' | 'moon';
	external: boolean;
	/** Video poster where one exists; blog posts and projects have none. */
	thumbnailUrl: string | null;
	/** Set for videos so the lead story can play in place. */
	embedUrl: string | null;
	videoUrl?: string;
}

// Get latest blog posts
const blogPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
	return data.draft !== true;
});
const blogItems = blogPosts.map(
	(post: CollectionEntry<'blog'>): FeedItem => ({
		title: post.data.title,
		url: `/blog/${post.id}/`,
		date: post.data.pubDate,
		kind: 'Article',
		description:
			post.id === 'one-key-to-the-whole-dungeon'
				? 'This issue of Arcane Scrolls explains how a shared token cache can let one person use another’s permissions.'
				: post.data.description,
		realm: 'library',
		external: false,
		thumbnailUrl: null,
		embedUrl: null,
	})
);

// Get latest talks (manual + YouTube)
const { manualTalks, youtubeTalks } = getTalkCatalogue<CollectionEntry<'talks'>>(
	await getCollection('talks'),
	await fetchYouTubeTalks()
);

const allTalks: FeedItem[] = [
	...manualTalks.map(
		(talk: CollectionEntry<'talks'>): FeedItem => ({
			title: talk.data.title,
			url: `/talks/#${talk.id}`,
			date: talk.data.date,
			kind: getTalkKind(talk.data.event, talk.data.tags),
			description: talk.data.summary,
			realm: 'tower',
			external: false,
			thumbnailUrl: getYouTubeThumbnailUrl(talk.data.videoUrl),
			embedUrl: getYouTubeEmbedUrl(talk.data.videoUrl),
			videoUrl: talk.data.videoUrl,
		})
	),
	...youtubeTalks.map(
		(talk: YouTubeTalk, index: number): FeedItem => ({
			title: talk.title,
			url: `/talks/#youtube-${index}`,
			date: talk.date,
			kind: getTalkKind(talk.event, talk.tags),
			description: talk.summary,
			realm: 'tower',
			external: false,
			thumbnailUrl: getYouTubeThumbnailUrl(talk.videoUrl),
			embedUrl: getYouTubeEmbedUrl(talk.videoUrl),
			videoUrl: talk.videoUrl,
		})
	),
];

const projects = await getCollection('projects');
const projectItems = projects.flatMap((project: CollectionEntry<'projects'>): FeedItem[] =>
	project.data.firstPublic
		? [
				{
					title: project.data.name,
					url: `/forge/#${project.id}`,
					date: project.data.firstPublic,
					kind: 'Project',
					description: project.data.description,
					realm: 'forge',
					external: false,
					thumbnailUrl: null,
					embedUrl: null,
				},
			]
		: []
);

const youtubeShorts = await fetchYouTubeShorts();
const shortItems = youtubeShorts.map(
	(short: YouTubeShort): FeedItem => ({
		title: short.title,
		url: short.videoUrl,
		date: short.pubDate,
		kind: 'Short',
		description: toSummary(short.description, 150),
		realm: 'moon',
		external: true,
		thumbnailUrl: short.thumbnailUrl,
		embedUrl: short.embedUrl,
		videoUrl: short.videoUrl,
	})
);

const { featured: heroItem, rows: restItems } = selectQuestLog([
	...blogItems,
	...allTalks,
	...projectItems,
	...shortItems,
]);
---

<Base>
  <div class="container page-shell">
    <section class="section-stack hero">
      <div class="hero__copy">
        <h1 class="hero__title">AI governance, platforms and cybersecurity</h1>
        <CredibilityStrip />
        <p class="hero-cta">
          <a href="/#listen" class="btn-primary">Listen to the podcast</a>
        </p>
      </div>

      {
        heroItem?.embedUrl && heroItem.videoUrl && (
          <article class="lead-story content-card" data-realm={heroItem.realm}>
            <div class="lead-story__media">
              <VideoFacade
                embedUrl={heroItem.embedUrl}
                videoUrl={heroItem.videoUrl}
                title={heroItem.title}
                thumbnailUrl={heroItem.thumbnailUrl}
                realm={heroItem.realm === 'moon' ? 'moon' : 'tower'}
                eager
              />
            </div>
            <div class="lead-story__body">
              <h2 class="lead-story__title">
                <a
                  href={heroItem.url}
                  target={heroItem.external ? '_blank' : undefined}
                  rel={heroItem.external ? 'noopener noreferrer' : undefined}
                >
                  {heroItem.title}
                  {heroItem.external && (
                    <span class="ext-glyph" aria-hidden="true">
                      ↗
                    </span>
                  )}
                  {heroItem.external && <span class="sr-only"> (opens in new tab)</span>}
                </a>
              </h2>
              <p class="quest-eyebrow">
                <span class="quest-kind"><RealmSigil realm={heroItem.realm} size={20} />{heroItem.kind}</span>
                <time datetime={heroItem.date.toISOString()}>{formatIndexDate(heroItem.date)}</time>
              </p>
            </div>
          </article>
        )
      }
    </section>

    <div class="discovery section-stack">
      <section class="log-section" aria-labelledby="quest-heading">
        <div class="log-heading">
          <h2 id="quest-heading" class="section-heading">Quest Log</h2>
          <a href="/talks/#full-episodes">Browse full episodes</a>
        </div>
        <ul class="quest-log">
          {
            restItems.map((item: FeedItem, index: number) => (
              <li>
                <a
                  href={item.url}
                  class="quest-row"
                  aria-labelledby={`quest-title-${index}`}
                  data-realm={item.realm}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <div class="quest-row__body">
                    <h3 id={`quest-title-${index}`} class="quest-row__title">
                      {item.title}
                      {item.external && (
                        <span class="ext-glyph" aria-hidden="true">
                          ↗
                        </span>
                      )}
                      {item.external && <span class="sr-only"> (opens in new tab)</span>}
                    </h3>
                    <p class="quest-eyebrow">
                      <span class="quest-kind"><RealmSigil realm={item.realm} size={20} />{item.kind}</span>
                      <time datetime={item.date.toISOString()}>{formatIndexDate(item.date)}</time>
                    </p>
                    {item.description && <p class="quest-row__summary">{item.description}</p>}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="quest-log__more">
          <a href="/talks/">All talks and episodes →</a>
          <a href="/shorts/">All shorts →</a>
        </p>
      </section>

      <section class="map-section" aria-labelledby="map-heading">
        <h2 id="map-heading" class="section-heading">Map of the Realm</h2>
        <p class="map-subhead">Pick a door.</p>
        <CastleSceneRetro />
      </section>
    </div>

    <ListenHub band={true} />

    {/* Signup is a hosted Riverside page, so this links out. Swapping the button for
        an inline field is a small diff once there is an endpoint to POST to. */}
    <section class="section-stack newsletter-band" aria-labelledby="scrolls-heading">
      <div class="newsletter-band__panel notched">
      <h2 id="scrolls-heading" class="section-heading">Arcane Scrolls</h2>
      <p class="newsletter-band__blurb">
        The newsletter. Episodes and writeups, in your inbox. We send one when there is one.
      </p>
      <a
        href="https://str.riverside.com/newsletter"
        class="btn-primary notched"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Subscribe to Arcane Scrolls (opens in new tab)">Subscribe</a
      >
      </div>
    </section>

    <section
      class="section-stack"
      style="max-width: var(--max-width-prose); margin-inline: auto; text-align: center;"
    >
      <h2 class="section-heading">The Party</h2>
      <p class="measure" style="font-size: var(--font-size-lg); line-height: var(--line-height-relaxed); text-align: center;">
        In the Christmas special, Chris and Josh talked about building an AI dungeon master.
      </p>
      <a href="/about/" class="btn-outline notched" style="margin-top: var(--space-6);">
        Meet the party →
      </a>
    </section>
  </div>
</Base>

<style>
  .ext-glyph {
    margin-left: var(--space-1);
    color: var(--colour-gold);
  }

  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    background-image:
      radial-gradient(var(--colour-star) 1px, transparent 1px),
      radial-gradient(var(--colour-star) 2px, transparent 2px);
    background-size: 200px 240px, 360px 320px;
    background-position: 0 0, 72px 88px;
  }

  .hero__title {
    line-height: var(--line-height-title);
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }

  @media (min-width: 1025px) {
    .hero:has(.lead-story) {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-12);
    }
  }

  .lead-story {
    display: block;
    padding: 0;
    overflow: hidden;
  }

  .lead-story__media {
    display: block;
    border-bottom: 2px solid var(--realm-accent);
  }

  .lead-story__body {
    padding: var(--space-inner);
  }

  .content-card .lead-story__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display-readable);
    font-weight: var(--font-weight-bold);
    font-variant-caps: normal;
    font-size: var(--font-size-xl);
    line-height: var(--line-height-snug);
    letter-spacing: 0;
    color: var(--colour-parchment);
  }

  .lead-story__title a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lead-story__title a:hover,
  .lead-story__title a:focus-visible {
    text-decoration: underline;
  }

  .hero-cta {
    margin: var(--space-4) 0 0;
  }

  .discovery {
    display: grid;
    gap: var(--space-section);
    align-items: start;
  }

  .log-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .log-heading .section-heading,
  .map-section .section-heading {
    margin-bottom: 0;
  }

  .log-heading .section-heading::before,
  .log-heading .section-heading::after {
    display: none;
  }

  .map-subhead {
    margin: var(--space-2) 0 var(--space-3);
    text-align: center;
    color: var(--colour-parchment);
  }

  @media (min-width: 72em) {
    .discovery {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }

  .newsletter-band {
    text-align: center;
  }

  /* A notched panel gives the section edges; without them it floated */
  .newsletter-band__panel {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-12);
    background: var(--colour-teal-dark);
    border: 2px solid var(--colour-gold);
  }

  /* The 720px panel is already the measure, so the blurb needs no width of its own */
  .newsletter-band__blurb {
    margin: 0 auto var(--space-6);
    color: var(--colour-parchment);
  }

  .quest-log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .quest-log__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-4) 0 0;
  }

  .quest-row {
    display: block;
    padding: var(--space-inner);
    border: 1px solid var(--colour-stone-dark);
    border-radius: var(--radius-pixel);
    text-decoration: none;
    color: inherit;
  }

  .quest-row:hover,
  .quest-row:focus-visible {
    background: var(--colour-teal-dark);
    border-color: var(--colour-gold);
  }

  .quest-row__title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-snug);
    color: var(--colour-parchment);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .quest-row__summary {
    margin: var(--space-3) 0 0;
    color: var(--colour-parchment);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
  }

  .quest-eyebrow,
  .quest-kind {
    display: flex;
    align-items: center;
  }

  .quest-eyebrow {
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    color: var(--colour-stone-light);
    font-size: var(--font-size-sm);
  }

  .quest-kind {
    gap: var(--space-2);
  }

  .lead-story:hover {
    transform: translate(2px, 2px);
    box-shadow: var(--card-chrome-pressed);
  }

  @media (prefers-reduced-motion: reduce) {
    .lead-story:hover {
      transform: none;
    }
  }
</style>
