---
import EpisodePoster from '../../components/EpisodePoster.astro';
import MoonIcon from '../../components/MoonIcon.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubscribeChip from '../../components/SubscribeChip.astro';
import Base from '../../layouts/Base.astro';
import { formatIndexDate } from '../../utils/dates';
import {
	fetchYouTubeShorts,
	type RelatedContentLink,
	type YouTubeShort,
} from '../../utils/youtube';

const shorts = await fetchYouTubeShorts();
const sortedShorts = [...shorts].sort(
	(a: YouTubeShort, b: YouTubeShort) => b.pubDate.valueOf() - a.pubDate.valueOf()
);
const allTags = [...new Set(shorts.flatMap((short: YouTubeShort) => short.tags))].sort();
const isTopic = (tag: string): boolean => tag !== 'Shorts' && tag !== 'YouTube';
---

<Base title="Moon - Shorts">
  <div class="container page-shell">
    <PageHeader title="The Moon · Shorts" realm="moon">
      <MoonIcon slot="icon" />
      Short clips from the studio and the road.
      <SubscribeChip
        slot="actions"
        href="https://www.youtube.com/@SecuringTheRealm"
        label="Subscribe on YouTube"
        platform="YouTube"
      />
    </PageHeader>

    {allTags.length > 0 && (
      <details class="archive-links">
        <summary>Browse topics</summary>
        <div class="short-tags">
          {allTags.map((tag: string) => <a href={`/tags/${tag}/`} class="tag-chip">{tag}</a>)}
        </div>
      </details>
    )}

    <div class="shorts-grid" data-realm="moon">
      {sortedShorts.length === 0 && <p>Nothing from the Moon yet. Look up again shortly.</p>}
      {sortedShorts.map((short: YouTubeShort, index: number) => (
        <article class="short-card">
          <a href={short.videoUrl} target="_blank" rel="noopener noreferrer" class="short-watch" aria-label={`Watch ${short.title} on YouTube`}>
            <div class="short-frame">
              <EpisodePoster realm="moon" thumbnailUrl={short.thumbnailUrl} eager={index < 3} />
              <span class="play-icon" aria-hidden="true">&#9654;</span>
            </div>
            <h2 class="short-title">{short.title}</h2>
          </a>
          <div class="short-content">
            <time class="short-date" datetime={short.pubDate.toISOString()}>{formatIndexDate(short.pubDate)}</time>
            {short.relatedContent.length > 0 && (
              <div class="short-related">
                {short.relatedContent.map((link: RelatedContentLink) => (
                  <a href={link.url}>{link.title}</a>
                ))}
              </div>
            )}
            {short.tags.some(isTopic) && (
              <div class="short-tags">
                {short.tags.filter(isTopic).map((tag: string) => (
                  <a href={`/tags/${tag}/`} class="tag-chip">{tag}</a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.short-watch').forEach(function (link) {
      link.addEventListener('click', function () {
        if (typeof plausible !== 'undefined') {
          var title = link.querySelector('.short-title');
          plausible('Short Watch', { props: { title: title ? title.textContent.trim() : 'Unknown' } });
        }
      });
    });
  </script>
</Base>

<style>
  .shorts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
    align-items: start;
  }

  .short-card {
    min-width: 0;
    border: 1px solid var(--colour-stone-dark);
    border-radius: var(--radius-pixel);
    background: var(--colour-teal-dark);
  }

  .short-watch,
  .short-frame {
    display: block;
  }

  .short-watch {
    color: var(--colour-parchment);
  }

  .short-frame {
    position: relative;
  }

  .play-icon {
    position: absolute;
    inset-inline-end: var(--space-3);
    inset-block-end: var(--space-3);
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    color: var(--colour-ink);
    background: var(--colour-gold);
    border: 2px solid var(--colour-ink);
    border-radius: var(--radius-pixel);
    line-height: 1;
  }

  .short-title {
    margin: 0;
    padding: var(--space-6) var(--space-6) 0;
    color: inherit;
    font-size: var(--font-size-xl);
    text-decoration: underline;
    text-decoration-color: var(--colour-stone-dark);
    text-underline-offset: 0.16em;
  }

  .short-watch:hover .short-title,
  .short-watch:focus-visible .short-title {
    color: var(--colour-gold-light);
    text-decoration-color: currentColor;
  }

  .short-content {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-6) var(--space-6);
  }

  .short-date,
  .archive-links {
    color: var(--colour-stone-light);
    font-size: var(--font-size-sm);
  }

  .short-related,
  .short-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    align-items: baseline;
  }

  .short-related a,
  .archive-links summary {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .archive-links {
    margin-block-end: var(--space-6);
  }

  .archive-links summary {
    width: fit-content;
    cursor: pointer;
  }

  .archive-links summary:focus-visible {
    outline: 2px solid var(--colour-gold);
    outline-offset: var(--space-1);
  }

  .archive-links .short-tags {
    margin-block-start: var(--space-3);
  }
</style>
