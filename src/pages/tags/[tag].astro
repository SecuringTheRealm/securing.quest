---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { formatIndexDate } from '../../utils/dates';
import { getDedupedYouTubeTalks } from '../../utils/talks';
import { fetchYouTubeShorts, fetchYouTubeTalks, toSummary } from '../../utils/youtube';

interface TaggedContent {
	title: string;
	url: string;
	date: Date;
	source: string;
	description: string;
}

export const getStaticPaths = (async () => {
	const blogPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
		return data.draft !== true;
	});

	const manualTalks = await getCollection('talks');
	const youtubeTalks = await fetchYouTubeTalks();
	const youtubeShorts = await fetchYouTubeShorts();

	const dedupedYouTubeTalks = getDedupedYouTubeTalks(manualTalks, youtubeTalks);

	// Collect all tags and their content
	const tagMap = new Map<string, TaggedContent[]>();

	function addToTag(tag: string, item: TaggedContent): void {
		if (!tagMap.has(tag)) {
			tagMap.set(tag, []);
		}
		tagMap.get(tag)?.push(item);
	}

	// Blog posts
	for (const post of blogPosts) {
		for (const tag of post.data.tags) {
			addToTag(tag, {
				title: post.data.title,
				url: `/blog/${post.id}/`,
				date: post.data.pubDate,
				source: 'Library · Blog',
				description: post.data.description,
			});
		}
	}

	// Manual talks
	for (const talk of manualTalks) {
		for (const tag of talk.data.tags) {
			addToTag(tag, {
				title: talk.data.title,
				url: `/talks/#${talk.id}`,
				date: talk.data.date,
				source: 'Tower · Talks',
				description: talk.data.summary,
			});
		}
	}

	// YouTube talks
	for (const [index, talk] of dedupedYouTubeTalks.entries()) {
		for (const tag of talk.tags) {
			addToTag(tag, {
				title: talk.title,
				url: `/talks/#youtube-${index}`,
				date: talk.date,
				source: 'Tower · Talks',
				description: talk.summary,
			});
		}
	}

	// YouTube shorts (with overrides)
	for (const short of youtubeShorts) {
		for (const tag of short.tags) {
			addToTag(tag, {
				title: short.title,
				url: `/shorts/`,
				date: short.pubDate,
				source: 'Moon · Shorts',
				description: short.description || 'A short from the Securing the Realm YouTube channel.',
			});
		}
	}

	return Array.from(tagMap.entries()).map(([tag, items]) => ({
		params: { tag },
		props: {
			tag,
			items: items.sort(
				(a: TaggedContent, b: TaggedContent) => b.date.valueOf() - a.date.valueOf()
			),
		},
	}));
}) satisfies GetStaticPaths;

interface Props {
	tag: string;
	items: TaggedContent[];
}

const { tag, items } = Astro.props as Props;
---

<Base title={`Tag: ${tag}`} description={`Content tagged with "${tag}" on Securing the Realm.`}>
  <div class="container page-shell archive-page">
    <header class="archive-heading">
      <p>Tag</p>
      <h1>{tag}</h1>
      <p>{items.length} {items.length === 1 ? 'item' : 'items'} tagged</p>
    </header>

    <div class="archive-list">
      {items.map((item: TaggedContent, index: number) => (
        <a href={item.url} class="feed-item content-card" aria-labelledby={`result-${index}`}>
          <h2 id={`result-${index}`}>{item.title}</h2>
          <div class="archive-meta">
            <span>{item.source}</span>
            <time datetime={item.date.toISOString()}>{formatIndexDate(item.date)}</time>
          </div>
          <p>{toSummary(item.description, 150)}</p>
        </a>
      ))}
    </div>

    <a href="/" class="archive-home">← Back to Castle Gate</a>
  </div>
</Base>

<style>
  .archive-page {
    max-width: var(--max-width-content);
  }

  .archive-heading {
    margin-block-end: var(--space-6);
  }

  .archive-heading h1 {
    margin-block: var(--space-1) var(--space-2);
  }

  .archive-heading p,
  .feed-item h2,
  .feed-item p {
    margin: 0;
  }

  .archive-heading p,
  .archive-meta {
    color: var(--colour-stone-light);
    font-size: var(--font-size-sm);
  }

  .archive-list,
  .feed-item {
    display: grid;
    gap: var(--space-3);
  }

  .feed-item {
    color: var(--colour-parchment);
    padding: var(--space-6);
    border-color: var(--colour-stone-dark);
    box-shadow: none;
  }

  .feed-item h2 {
    color: var(--colour-parchment);
    font-size: var(--font-size-xl);
    text-decoration: underline;
    text-decoration-color: var(--colour-stone-dark);
    text-underline-offset: 0.16em;
  }

  .feed-item:hover h2,
  .feed-item:focus-visible h2 {
    color: var(--colour-gold-light);
    text-decoration-color: currentColor;
  }

  .archive-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .archive-home {
    display: inline-block;
    margin-block-start: var(--space-10);
    text-decoration: underline;
  }
</style>
