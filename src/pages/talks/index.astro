---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import SubscribeChip from '../../components/SubscribeChip.astro';
import TowerIcon from '../../components/TowerIcon.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import Base from '../../layouts/Base.astro';
import { formatIndexDate } from '../../utils/dates';
import {
	getFormerTalkAnchor,
	getTalkCatalogue,
	getTalkKind,
	type TalkKind,
} from '../../utils/talks';
import {
	fetchYouTubeTalks,
	getYouTubeEmbedUrl,
	getYouTubeThumbnailUrl,
	type YouTubeTalk,
} from '../../utils/youtube';

// Unified talk type for rendering
interface UnifiedTalk {
	id: string;
	title: string;
	date: Date;
	event: string;
	kind: TalkKind;
	videoUrl?: string;
	previewUrl?: string;
	slidesUrl?: string;
	eventUrl?: string;
	summary: string;
	tags: string[];
	embedUrl: string | null;
	thumbnailUrl: string | null;
}

const { manualTalks, youtubeTalks } = getTalkCatalogue<CollectionEntry<'talks'>>(
	await getCollection('talks'),
	await fetchYouTubeTalks()
);

// Convert manual talks to unified format
const unifiedManualTalks: UnifiedTalk[] = manualTalks.map((talk: CollectionEntry<'talks'>) => ({
	id: talk.id,
	title: talk.data.title,
	date: talk.data.date,
	event: talk.data.event,
	kind: getTalkKind(talk.data.event, talk.data.tags),
	videoUrl: talk.data.videoUrl,
	previewUrl: talk.data.previewUrl,
	slidesUrl: talk.data.slidesUrl,
	eventUrl: talk.data.eventUrl,
	summary: talk.data.summary,
	tags: talk.data.tags,
	embedUrl: getYouTubeEmbedUrl(talk.data.videoUrl),
	thumbnailUrl: getYouTubeThumbnailUrl(talk.data.videoUrl),
}));

// Convert YouTube talks to unified format
const unifiedYouTubeTalks: UnifiedTalk[] = youtubeTalks.map((talk: YouTubeTalk, index: number) => ({
	id: `youtube-${index}`,
	title: talk.title,
	date: talk.date,
	event: talk.event,
	kind: getTalkKind(talk.event, talk.tags),
	videoUrl: talk.videoUrl,
	summary: talk.summary,
	tags: talk.tags,
	embedUrl: getYouTubeEmbedUrl(talk.videoUrl),
	thumbnailUrl: getYouTubeThumbnailUrl(talk.videoUrl),
}));

// Merge and sort all talks by date (newest first)
const allTalks = [...unifiedManualTalks, ...unifiedYouTubeTalks].sort(
	(a: UnifiedTalk, b: UnifiedTalk) => b.date.valueOf() - a.date.valueOf()
);

interface TalkGroup {
	id: string;
	title: string;
	talks: UnifiedTalk[];
}

const groups = [
	{
		id: 'full-episodes',
		title: 'Full episodes',
		talks: allTalks.filter((talk: UnifiedTalk) => talk.kind === 'Full episode'),
	},
	{
		id: 'conference-sessions',
		title: 'Conference talks and workshops',
		talks: allTalks.filter((talk: UnifiedTalk) => talk.kind !== 'Full episode'),
	},
].filter((group: TalkGroup) => group.talks.length > 0);

const firstVideo = groups
	.flatMap((group: TalkGroup) => group.talks)
	.find((talk: UnifiedTalk) => talk.embedUrl);
---

<Base title="Tower - Talks & Presentations">
  <div class="container page-shell talks-shell">
    <PageHeader title="The Tower · Talks" realm="tower">
      <TowerIcon slot="icon" />
      Workshops, talks and full episodes from conference stages and the studio.
      <SubscribeChip
        slot="actions"
        href="https://www.youtube.com/@SecuringTheRealm"
        label="Subscribe on YouTube"
        platform="YouTube"
      />
    </PageHeader>

    {allTalks.length === 0 ? (
      <p>No episodes or talks in the Tower yet.</p>
    ) : (
      <>
        <nav class="catalogue-jumps" aria-label="Talks catalogue">
          {groups.map((group: TalkGroup) => (
            <a href={`#${group.id}`}>{group.title}</a>
          ))}
        </nav>

        {groups.map((group: TalkGroup) => (
          <section class="talk-group" aria-labelledby={group.id}>
            <h2 id={group.id} tabindex="-1">{group.title}</h2>
            <div class="talk-list" data-realm="tower">
              {group.talks.map((talk: UnifiedTalk) => (
                <article id={talk.id} class="talk-card content-card">
                  <div class="talk-copy">
                    <h3 id={getFormerTalkAnchor(talk.videoUrl)}>{talk.title}</h3>
                    <p class="talk-meta">
                      <span>{talk.kind}</span>
                      {talk.kind !== 'Full episode' && <span>{talk.event.replace(/\s*·\s*Workshop$/i, '')}</span>}
                      <time datetime={talk.date.toISOString()}>{formatIndexDate(talk.date)}</time>
                    </p>
                  </div>
                  {talk.embedUrl && talk.videoUrl && (
                    <div class="talk-media">
                      <VideoFacade
                        embedUrl={talk.embedUrl}
                        videoUrl={talk.videoUrl}
                        thumbnailUrl={talk.thumbnailUrl}
                        title={talk.title}
                        eager={talk === firstVideo}
                      />
                    </div>
                  )}
                  <p class="talk-summary">{talk.summary}</p>
                  <div class="talk-links">
                    {(talk.previewUrl || talk.slidesUrl || talk.eventUrl || (talk.videoUrl && !talk.embedUrl)) && (
                      <div class="talk-actions">
                        {talk.videoUrl && !talk.embedUrl && (
                          <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" data-action="video">Watch recording</a>
                        )}
                        {talk.previewUrl && (
                          <a href={talk.previewUrl} target="_blank" rel="noopener noreferrer" data-action="preview">Watch preview</a>
                        )}
                        {talk.slidesUrl && (
                          <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" data-action="slides">View slides</a>
                        )}
                        {talk.eventUrl && (
                          <a href={talk.eventUrl} target="_blank" rel="noopener noreferrer" data-action="event">Event details</a>
                        )}
                      </div>
                    )}
                    {talk.tags.length > 0 && (
                      <details class="talk-topics">
                        <summary>Topics</summary>
                        <div class="talk-tags">
                          {talk.tags.map((tag: string) => (
                            <a href={`/tags/${tag}/`} class="tag-chip">{tag}</a>
                          ))}
                        </div>
                      </details>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </>
    )}
  </div>

  <style>
    .talks-shell {
      max-width: min(var(--container), calc(var(--max-width-content) + var(--space-12)));
    }

    .catalogue-jumps,
    .talk-actions,
    .talk-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      align-items: baseline;
    }

    .catalogue-jumps a,
    .talk-actions a {
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }

    .catalogue-jumps {
      padding-block-end: var(--space-4);
      border-block-end: 1px solid var(--colour-stone-dark);
      margin-block-end: var(--space-6);
    }

    .talk-group + .talk-group {
      margin-block-start: var(--space-12);
    }

    .talk-list,
    .talk-card,
    .talk-links {
      display: grid;
      gap: var(--space-4);
    }

    .talk-card {
      min-width: 0;
      padding: var(--space-6);
      border-color: var(--colour-stone-dark);
      box-shadow: none;
    }

    .talk-copy {
      min-width: 0;
    }

    .talk-copy h3 {
      color: var(--colour-parchment);
      font-size: var(--font-size-xl);
      margin-block-end: var(--space-2);
    }

    .talk-meta,
    .talk-topics {
      font-size: var(--font-size-sm);
      color: var(--colour-stone-light);
    }

    .talk-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-3);
      margin: 0;
    }

    .talk-summary {
      margin: 0;
    }

    .talk-tags {
      margin-block-start: var(--space-3);
    }

    .talk-topics summary {
      width: fit-content;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }

    .talk-topics summary:focus-visible {
      outline: 2px solid var(--colour-gold);
      outline-offset: var(--space-1);
    }

    .talk-media {
      min-width: 0;
      align-self: start;
    }

    @media (min-width: 769px) {
      :global(.talk-card:has(.talk-media):not(:has(.video-player.is-playing))) {
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
        align-items: start;
      }

      :global(.talk-card:has(.talk-media):not(:has(.video-player.is-playing))) .talk-media {
        grid-column: 2;
        grid-row: 1 / span 2;
      }
    }
  </style>

  <script is:inline>
    document.querySelectorAll('article').forEach(function (article) {
      var title = (article.querySelector('h3') || {}).textContent || 'Unknown';
      article.querySelectorAll('a[target="_blank"]').forEach(function (link) {
        link.addEventListener('click', function () {
          if (typeof plausible === 'undefined') return;
          var action = link.getAttribute('data-action') || 'other';
          if (action === 'other') {
            var text = (link.textContent || '').trim().toLowerCase();
            if (text.indexOf('watch') !== -1 || text.indexOf('video') !== -1) action = 'video';
            else if (text.indexOf('slides') !== -1) action = 'slides';
            else if (text.indexOf('event') !== -1) action = 'event';
          }
          plausible('Talk Engagement', { props: { talk: title.trim(), action: action } });
        });
      });
    });
  </script>
</Base>
