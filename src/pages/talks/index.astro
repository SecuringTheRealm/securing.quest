---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import SubscribeChip from '../../components/SubscribeChip.astro';
import TowerIcon from '../../components/TowerIcon.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import Base from '../../layouts/Base.astro';
import { getDedupedYouTubeTalks } from '../../utils/talks';
import {
	fetchYouTubeTalks,
	getYouTubeEmbedUrl,
	getYouTubeThumbnailUrl,
	type YouTubeTalk,
} from '../../utils/youtube';

// Unified talk type for rendering
interface UnifiedTalk {
	id: string;
	title: string;
	date: Date;
	event: string;
	videoUrl?: string;
	previewUrl?: string;
	slidesUrl?: string;
	eventUrl?: string;
	summary: string;
	tags: string[];
	embedUrl: string | null;
	thumbnailUrl: string | null;
}

// Get manual talks from content collection
const manualTalks = await getCollection('talks');

// Get YouTube talks dynamically at build time
const youtubeTalks = await fetchYouTubeTalks();

// Convert manual talks to unified format
const unifiedManualTalks: UnifiedTalk[] = manualTalks.map((talk: CollectionEntry<'talks'>) => ({
	id: talk.id,
	title: talk.data.title,
	date: talk.data.date,
	event: talk.data.event,
	videoUrl: talk.data.videoUrl,
	previewUrl: talk.data.previewUrl,
	slidesUrl: talk.data.slidesUrl,
	eventUrl: talk.data.eventUrl,
	summary: talk.data.summary,
	tags: talk.data.tags,
	embedUrl: getYouTubeEmbedUrl(talk.data.videoUrl),
	thumbnailUrl: getYouTubeThumbnailUrl(talk.data.videoUrl),
}));

const dedupedYouTubeTalks = getDedupedYouTubeTalks(manualTalks, youtubeTalks);

// Convert YouTube talks to unified format
const unifiedYouTubeTalks: UnifiedTalk[] = dedupedYouTubeTalks.map(
	(talk: YouTubeTalk, index: number) => ({
		id: `youtube-${index}`,
		title: talk.title,
		date: talk.date,
		event: talk.event,
		videoUrl: talk.videoUrl,
		summary: talk.summary,
		tags: talk.tags,
		embedUrl: getYouTubeEmbedUrl(talk.videoUrl),
		thumbnailUrl: getYouTubeThumbnailUrl(talk.videoUrl),
	})
);

// Merge and sort all talks by date (newest first)
const allTalks = [...unifiedManualTalks, ...unifiedYouTubeTalks].sort(
	(a: UnifiedTalk, b: UnifiedTalk) => b.date.valueOf() - a.date.valueOf()
);
---

<Base title="Tower - Talks & Presentations">
  <div class="container page-shell talks-shell">
    <PageHeader title="The Tower · Talks" realm="tower">
      <TowerIcon slot="icon" />
      Workshops, talks and full episodes from conference stages and the studio.
      <SubscribeChip
        slot="actions"
        href="https://www.youtube.com/@SecuringTheRealm"
        label="Subscribe on YouTube"
        platform="YouTube"
      />
    </PageHeader>

    <div class="talk-list" data-realm="tower">
      {allTalks.length === 0 && (
        <p style="text-align: center; color: var(--colour-stone-light); font-size: var(--font-size-lg);">
          No talks yet. Check back soon for upcoming presentations!
        </p>
      )}
      {allTalks.map((talk: UnifiedTalk, index: number) => (
        <article id={talk.id} class="talk-card content-card">
          <div class="talk-copy">
            <h2>{talk.title}</h2>
            <p class="talk-meta">
              {talk.event} • {talk.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </p>
            <p class="talk-summary">{talk.summary}</p>
          </div>
          {talk.embedUrl && talk.videoUrl && (
            <div class="talk-media">
              <VideoFacade
                embedUrl={talk.embedUrl}
                videoUrl={talk.videoUrl}
                thumbnailUrl={talk.thumbnailUrl}
                title={talk.title}
                eager={index === 0}
              />
            </div>
          )}
          <div class="talk-links">
            <div class="talk-actions">
              {talk.videoUrl && !talk.embedUrl && (
                <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary btn-sm">
                  Watch Video
                </a>
              )}
              {talk.previewUrl && (
                <a href={talk.previewUrl} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm" data-action="preview">
                  Watch preview
                </a>
              )}
              {talk.slidesUrl && (
                <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm">
                  View Slides
                </a>
              )}
              {talk.eventUrl && (
                <a href={talk.eventUrl} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm">
                  Event Details
                </a>
              )}
            </div>

            {talk.tags.length > 0 && (
              <div class="talk-tags">
                {talk.tags.map((tag: string) => (
                  <a href={`/tags/${tag}/`} class="tag-chip">
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <style>
    .talks-shell {
      max-width: min(var(--container), calc(var(--max-width-content) + var(--space-12)));
    }

    .talk-list {
      display: grid;
      gap: var(--space-6);
    }

    .talk-card {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-4);
      border-color: var(--realm-accent);
    }

    .talk-copy h2,
    .talk-meta {
      margin-block-end: var(--space-2);
    }

    .talk-meta {
      font-size: var(--font-size-sm);
      color: var(--colour-stone-light);
    }

    .talk-summary {
      margin: 0;
    }

    .talk-links {
      display: grid;
      gap: var(--space-3);
    }

    .talk-links:empty,
    .talk-actions:empty {
      display: none;
    }

    .talk-actions,
    .talk-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .talk-media {
      min-width: 0;
      border: 2px solid var(--realm-accent);
      border-radius: var(--radius-pixel);
    }

    @media (min-width: 769px) {
      :global(.talk-card:has(.talk-media):not(:has(.video-player.is-playing))) {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        align-items: start;
      }

      :global(.talk-card:has(.talk-media):not(:has(.video-player.is-playing))) .talk-media {
        grid-column: 2;
        grid-row: 1 / span 2;
      }
    }
  </style>

  <script is:inline>
    document.querySelectorAll('article').forEach(function (article) {
      var title = (article.querySelector('h2') || {}).textContent || 'Unknown';
      article.querySelectorAll('a[target="_blank"]').forEach(function (link) {
        link.addEventListener('click', function () {
          if (typeof plausible === 'undefined') return;
          var action = link.getAttribute('data-action') || 'other';
          if (action === 'other') {
            var text = (link.textContent || '').trim().toLowerCase();
            if (text.indexOf('watch') !== -1 || text.indexOf('video') !== -1) action = 'video';
            else if (text.indexOf('slides') !== -1) action = 'slides';
            else if (text.indexOf('event') !== -1) action = 'event';
          }
          plausible('Talk Engagement', { props: { talk: title.trim(), action: action } });
        });
      });
    });
  </script>
</Base>
